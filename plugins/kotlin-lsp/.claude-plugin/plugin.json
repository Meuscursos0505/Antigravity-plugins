{
  "name": "kotlin-lsp",
  "version": "1.0.0",
  "description": "Kotlin language server for code intelligence",
  "author": {
    "name": "Anthropic (Adapted for Antigravity)"
  },
  "compatibility": "antigravity",
  "originalSource": "anthropics/claude-plugins-official/plugins/kotlin-lsp",
  "lspServers": {
    "kotlin-lsp": {
      "command": "kotlin-lsp",
      "args": [
        "--stdio"
      ],
      "extensionToLanguage": {
        ".kt": "kotlin",
        ".kts": "kotlin"
      },
      "startupTimeout": 120000
    }
  }
}